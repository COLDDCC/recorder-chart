{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recorder-chart",
  "compatibility_date": "2025-09-01",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
